POSTGRES_DB=med_annotate
POSTGRES_USER=med_annotate
POSTGRES_PASSWORD=med_annotate
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

BACKEND_CORS_ORIGINS=*
LOCAL_STORAGE_ROOT=./storage
# Optional JSON object mapping safe server import root aliases to absolute directories.
# Leave empty to disable Research video server-side import.
# RESEARCH_VIDEO_IMPORT_ROOTS={"dataset":"/data1/dataset","archive":"/data2/video_archive"}
# Optional. Research video trimming requires ffmpeg and ffprobe with a browser-compatible H.264 encoder.
# Supported encoders: libx264 or libopenh264. MPEG-4 Part 2 fallback is intentionally disabled.
RESEARCH_VIDEO_FFMPEG_BINARY=
RESEARCH_VIDEO_TRIM_MAX_CONCURRENCY=1
CONDA_ENV=../conda_envs/sam
SAM2_REPO_ROOT=../sam2
SAM2_CHECKPOINT=../sam2/checkpoints/sam2.1_hiera_large.pt
SAM2_MODEL_CFG=configs/sam2.1/sam2.1_hiera_l.yaml
SAM2_DEVICE=cuda
SAM2_LOAD_ON_STARTUP=true
SAM2_POLYGON_EPSILON_RATIO=0.002
SAM2_MIN_MASK_AREA=100
SAM2_MASK_THRESHOLD=0
SAM2_MAX_HOLE_AREA=0
SAM2_MAX_SPRINKLE_AREA=0

# Optional. Leave unset so the frontend uses the current browser host with port 8000.
# VITE_API_BASE_URL=http://localhost:8000
